{
  "name": "sessionbox-killer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An open-source conference program operating system built on Cloudflare.",
  "license": "MIT",
  "engines": {
    "node": ">=26.7.0 <27",
    "pnpm": ">=10.34.5 <11"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "scripts": {
    "build": "pnpm build:web && pnpm build:worker && pnpm cloudflare:demo:build",
    "build:web": "vite build --config apps/web/vite.config.ts && pnpm check:public-bundle",
    "build:worker": "wrangler deploy --dry-run --env=\"\" --config workers/app/wrangler.jsonc --outdir dist/worker",
    "cloudflare:build": "tsc --project scripts/cloudflare/tsconfig.build.json",
    "cloudflare:deploy:preview": "node scripts/cloudflare/private-deploy.mjs --build-web deploy --environment preview",
    "cloudflare:demo:bootstrap": "pnpm cloudflare:demo:build && node --conditions=sessionbox-operator-runtime --env-file-if-exists=.dev.vars .cloudflare/bin/demo-bootstrap.js",
    "cloudflare:demo:build": "pnpm --filter @sessionbox-killer/domain build && pnpm --filter @sessionbox-killer/data build && pnpm cloudflare:build && pnpm cloudflare:demo:runtime-check",
    "cloudflare:demo:runtime-check": "node --conditions=sessionbox-operator-runtime -e \"import('./packages/data/dist/airtable/internal.js')\"",
    "cloudflare:demo:smoke": "pnpm cloudflare:build && node --env-file-if-exists=.dev.vars .cloudflare/bin/demo-smoke.js",
    "cloudflare:plan": "pnpm cloudflare:run plan --environment preview",
    "cloudflare:public-performance:preview": "pnpm cloudflare:build && node .cloudflare/bin/public-performance.js --environment preview",
    "cloudflare:provision:preview": "pnpm cloudflare:run apply --environment preview",
    "cloudflare:rollback:preview": "pnpm cloudflare:run rollback --environment preview",
    "cloudflare:run": "node scripts/cloudflare/private-deploy.mjs",
    "cloudflare:smoke:preview": "pnpm cloudflare:run smoke --environment preview",
    "cloudflare:status": "pnpm cloudflare:run status --environment preview",
    "check:public-bundle": "node scripts/check-public-bundle-budget.mjs",
    "check:public-repo": "node scripts/check-public-repository.mjs",
    "dev": "pnpm build:web && wrangler dev --env=\"\" --config workers/app/wrangler.jsonc --local",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "deps:audit": "pnpm audit --audit-level high",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings 0",
    "preview": "pnpm build:web && wrangler dev --env=\"\" --config workers/app/wrangler.jsonc --local --port 8787",
    "preview:e2e": "pnpm build:web && node scripts/start-e2e-worker.mjs",
    "sbek": "node scripts/sbek.mjs",
    "sbek:prepare": "node scripts/sbek.mjs prepare",
    "sbek:verify": "node scripts/sbek.mjs verify",
    "test": "pnpm test:unit",
    "test:coverage": "pnpm build:web && vitest run --config vitest.config.ts --coverage --reporter=default --reporter=junit --outputFile.junit=coverage/test-results.junit.xml",
    "test:coverage:merge": "vitest --config vitest.config.ts --merge-reports=.vitest-reports --reporter=default --reporter=junit --outputFile.junit=coverage/test-results.junit.xml --coverage && node scripts/ci/verify-coverage.ts coverage/coverage-summary.json",
    "test:coverage:shard": "pnpm build:web && vitest run --config vitest.config.ts --coverage --reporter=blob",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:e2e:judge": "playwright test --config tests/e2e/playwright.config.ts --grep @judge",
    "test:e2e:merge": "playwright merge-reports --reporter=github,html blob-report",
    "test:e2e:production-smoke": "playwright test --config tests/e2e/playwright.config.ts --grep @production-smoke",
    "test:unit": "pnpm build:web && vitest run --config vitest.config.ts",
    "typecheck": "tsc --project scripts/ci/tsconfig.json && tsc --project scripts/cloudflare/tsconfig.json && pnpm -r --if-present typecheck",
    "wrangler:types": "wrangler types --config workers/app/wrangler.jsonc workers/app/worker-configuration.d.ts",
    "wrangler:types:check": "wrangler types --check --config workers/app/wrangler.jsonc workers/app/worker-configuration.d.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "esbuild": "0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fast-check": "4.10.0",
    "globals": "^17.12.0",
    "ical.js": "2.2.1",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.8.2",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  }
}
