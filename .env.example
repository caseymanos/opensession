# Safe names only. Copy to .dev.vars for local work; never commit real values.
# Non-secret runtime configuration
APP_ENV=local
APP_ORIGIN=http://localhost:8787
# Runtime Worker binding; operator commands intentionally ignore this value.
AIRTABLE_BASE_ID=
# Set AIRTABLE_ENVIRONMENT for remote schema/probe commands. The provisioner
# also reads the selected environment's base ID from these safe local inputs.
AIRTABLE_ENVIRONMENT=
AIRTABLE_PREVIEW_BASE_ID=
AIRTABLE_PRODUCTION_BASE_ID=
TURNSTILE_PREVIEW_SITE_KEY=
TURNSTILE_PRODUCTION_SITE_KEY=
# Operator-only second confirmation for production mutations; must equal production.
AIRTABLE_PRODUCTION_CONFIRM=
EMAIL_FROM=conference@example.com
EMAIL_REPLY_TO=conference@example.com
TURNSTILE_SITE_KEY=
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
ACCELEVENTS_EVENT_URL=
FEATURE_ACCELEVENTS=false
FEATURE_EMBEDS=false
FEATURE_AI_REVIEW=false

# Secrets: local values belong in .dev.vars; remote values use `wrangler secret put`.
AIRTABLE_PAT=
# Operator-only token for non-destructive schema bootstrap; may equal AIRTABLE_PAT during initial preview setup.
AIRTABLE_SCHEMA_PAT=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
AUTH_HASH_PEPPER=
WEBHOOK_SECRET_ENCRYPTION_KEY=
TURNSTILE_SECRET=
ACCELEVENTS_API_KEY=
AI_PROVIDER_API_KEY=
